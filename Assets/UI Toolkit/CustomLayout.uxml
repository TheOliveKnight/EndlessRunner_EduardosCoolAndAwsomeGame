                <ui:VisualElement name="SettingsPanelInner" style="flex-grow: 1; background-color: rgb(255, 230, 40); border-width: 5px; border-color: black; border-radius: 7px; border-top-width: 14px; border-top-color: rgb(255, 243, 128); border-left-width: 14px; border-left-color: rgb(255, 243, 128); border-bottom-width: 18px; border-bottom-color: rgb(245, 166, 35); border-right-width: 16px; border-right-color: rgb(245, 166, 35); padding: 26px 36px;">
