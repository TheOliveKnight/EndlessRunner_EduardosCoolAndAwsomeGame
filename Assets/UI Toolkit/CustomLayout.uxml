                    <ui:VisualElement style="width: 32px; height: 32px; background-color: rgb(150, 150, 150); border-width: 2px; border-color: black; border-radius: 4px; rotate: 45deg;"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="CoinCounterOuter" picking-mode="Ignore" style="position: absolute; top: 89px; left: 8px; background-color: white; border-radius: 8px; padding: 3px; translate: 0 0;">
            <ui:VisualElement name="CoinCounterBox" style="width: 310px; height: 84px; background-color: rgb(255, 230, 40); border-width: 3px; border-color: black; border-radius: 5px; border-top-color: rgb(255, 246, 130); border-left-color: rgb(255, 246, 130); border-bottom-width: 6px; border-bottom-color: rgb(245, 166, 35); border-right-width: 5px; border-right-color: rgb(245, 166, 35); padding: 10px 16px; justify-content: flex-start;">
                <ui:Label name="CoinCounterLabel" text="Coins Collected:" style="font-size: 18px; -unity-font-style: bold; color: black; padding-left: 10px; margin-left: -18px; padding-top: 10px;"/>
