                        <ui:Button name="CloseSettingsButton" text="✕" style="width: 52px; height: 52px; font-size: 28px; -unity-font-style: bold; color: black; background-color: rgb(245, 166, 35); border-width: 3px; border-color: black; border-radius: 8px;"/>
